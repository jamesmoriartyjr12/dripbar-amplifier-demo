# Optional. Leave these empty to run in demo mode with the labeled sample (no credentials, no microphone).
# Server-only: never prefix with NEXT_PUBLIC_, never commit real values. Copy to .env.local.
AMPLIFIER_ACCOUNT_ID=
AMPLIFIER_API_KEY=

# Optional override, e.g. http://localhost:4010 for scripts/mock-amplifier.mjs.
AMPLIFIER_BASE_URL=

# Required for live analysis anywhere other than localhost. Open the demo once with ?live=1&key=<value>.
DEMO_PRESENTER_KEY=
